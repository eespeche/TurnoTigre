@page
@model Web.Pages.RegistroModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="tt-register">
    <h1>Registrate como paciente</h1>
    <p class="tt-login-description">
        Necesitás tener domicilio en el partido de Tigre.
    </p>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger">@Model.Error</div>
    }

    <div asp-validation-summary="All" class="text-danger"></div>

    <form method="post">
        <div class="tt-register-grid">

            <div class="tt-field">
                <label for="nombre">Nombre</label>
                <input id="nombre" name="Nombre"
                       type="text" autocomplete="given-name"
                       maxlength="100"
                       placeholder="Ej.: Maria"
                       required />
            </div>

            <div class="tt-field">
                <label for="Apellido">Apellido</label>
                <input id="Apellido" name="Apellido"
                       type="text" autocomplete="family-name"
                       maxlength="100"
                       placeholder="Ej.: Perez"
                       required />
            </div>

            <div class="tt-field">
                <label for="dni">Número de DNI</label>
                <input id="dni" name="Dni"
                       type="text" inputmode="numeric"
                       pattern="[0-9]{7,8}" maxlength="8"
                       title="Ingresá entre 7 y 8 números, sin puntos"
                       placeholder="Sin puntos" required />
            </div>

            <div class="tt-field">
                <label for="fechaNacimiento">Fecha de nacimiento</label>
                <input id="fechaNacimiento" name="FechaNacimiento"
                       type="date" autocomplete="bday"
                       required />
            </div>

            <div class="tt-field">
                <label for="sexo">Sexo</label>
                <select id="sexo" name="Sexo" required>
                    <option value="">Seleccioná...</option>
                    <option value="Femenino">Femenino</option>
                    <option value="Masculino">Masculino</option>
                    <option value="X">X</option>
                </select>
            </div>

            <div class="tt-field">
                <label for="localidad">Localidad</label>
                <input id="localidad" name="Localidad"
                       type="text" maxlength="100"
                       placeholder="Ej.: Benavídez" required />
            </div>

            <div class="tt-field">
                <label for="calle">Calle</label>
                <input id="calle" name="Calle"
                       type="text" 
                       maxlength="100"
                       placeholder="Ej.: Av. Liniers"
                       required />
            </div>

            <div class="tt-field">
                <label for="altura">Altura</label>
                <input id="altura" name="Altura"
                       type="text"
                       inputmode="numeric"
                       maxlength="10"
                       placeholder="Ej.: 2840"
                       required />
            </div>

            <div class="tt-field">
                <label for="telefono">Teléfono</label>
                <input id="telefono" name="Telefono"
                       type="tel" autocomplete="tel"
                       maxlength="20" required />
            </div>

            <div class="tt-field">
                <label for="correo">Correo electrónico</label>
                <input id="correo" name="Correo"
                       type="email" autocomplete="email"
                       maxlength="100"
                       placeholder="nombre@correo.com"
                       required />
            </div>

            <div class="tt-field">
                <label for="contrasena">Contraseña</label>
                <input id="contrasena" name="Contrasena"
                       type="password"
                       autocomplete="new-password"
                       required />
            </div>

            <div class="tt-field">
                <label for="confirmacion">Confirmar contraseña</label>
                <input id="confirmacion" name="Confirmacion"
                       type="password"
                       autocomplete="new-password"
                       required />
            </div>
        </div>

        <button class="tt-button tt-button-red tt-register-submit"
                type="submit">
            Crear cuenta
        </button>
    </form>
</section>